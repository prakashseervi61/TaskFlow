# Normalize line endings so a checkout on Windows and a Linux container build produce
# identical files. Without this, CRLF/LF churn shows up as whole-file diffs.
* text=auto eol=lf

# Keep shell scripts executable and LF-only, even on Windows checkouts.
*.sh text eol=lf
*.bash text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.java text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.example text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.woff binary
*.woff2 binary
