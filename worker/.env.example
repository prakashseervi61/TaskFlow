# Worker environment variables. Copy to .env and fill in real values, or export them in your
# shell before starting the worker. Never commit the filled-in version.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskflow
DB_USERNAME=postgres
DB_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Optional overrides
JOB_QUEUE_KEY=taskflow:jobs
JOB_SIMULATED_DURATION_MS=2500
WORKER_CONCURRENCY=2
WORKER_POLL_TIMEOUT=5s
WORKER_RECOVER_ON_STARTUP=true
WORKER_FAILURE_MESSAGE=Job failed on purpose
WORKER_RETRY_SCAN_INTERVAL_MS=1000
WORKER_SERVER_PORT=8081

# Retry and backoff
JOB_DEFAULT_MAX_ATTEMPTS=3
JOB_RETRY_BASE_DELAY=5s
JOB_RETRY_MAX_DELAY=5m
