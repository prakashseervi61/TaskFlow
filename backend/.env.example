# Backend environment variables. Copy to .env and fill in real values, or export them
# in your shell before starting the backend. Never commit the filled-in version.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskflow
DB_USERNAME=postgres
DB_PASSWORD=

# Redis queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
JOB_QUEUE_KEY=taskflow:jobs

# Optional overrides
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Retry and backoff
JOB_DEFAULT_MAX_ATTEMPTS=3
JOB_RETRY_BASE_DELAY=5s
JOB_RETRY_MAX_DELAY=5m
